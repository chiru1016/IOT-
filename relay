Relay Module + LED

#define RELAY 23   // Relay IN pin connected to GPIO23

void setup() {

  pinMode(RELAY, OUTPUT);

  
  digitalWrite(RELAY, HIGH);

}

void loop() {

  // Turn ON relay (LED ON)
  digitalWrite(RELAY, LOW);

  delay(2000);

  // Turn off relay
  digitalWrite(RELAY, HIGH);

  delay(2000);
}