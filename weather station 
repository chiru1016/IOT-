int sensorPin = 2;

void setup() {
  pinMode(sensorPin, INPUT);
  Serial.begin(9600);
}

void loop() {
  int state = digitalRead(sensorPin);

  if (state == LOW) {
    Serial.println("Magnet Detected");
  } else {
    Serial.println("No Magnet");
  }

  delay(200);
}


